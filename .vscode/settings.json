{
  // Automatically restart all the other extensions after loading the direnv
  // environment. This way the other extensions will have the environment as well.
  "direnv.restart.automatic": true,
  "editor.defaultFormatter": "maximsmol.vscode-lsp-generic",
  "evenBetterToml.taplo.bundled": false,
  "files.associations": {
    ".envrc": "shellscript",
    "renovate.json": "jsonc",
    "shellcheckrc": "plaintext"
  },
  "fish-lsp.useGlobalExecutable": true,
  "lsp_generic_client.servers": {
    "efm-langserver": {
      "name": "efm-langserver",
      "path": "efm-langserver",
      "args": ["-c", "efm-langserver.yaml"],
      "documentSelector": [{ "pattern": "**", "scheme": "file" }]
    }
  },
  "ltex.completionEnabled": true,
  "ltex.enabled": ["git-commit", "markdown"],
  "Lua.misc.executablePath": "lua-language-server",
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "nixpkgs": { "expr": "import ./nix/packages.nix {}" },
      "options": {
        "comp_1": {
          "expr": "(import ./.).outputs.systemConfigs.comp_1.options"
        },
        "home-manager": {
          "expr": "with (import ./.); (inputs.home-manager.lib.homeManagerConfiguration { pkgs = inputs.nixpkgs.legacyPackages.${builtins.currentSystem}; modules = [./nix/modules/host/essentials {home.homeDirectory = \"/not-applicable\";}]; extraSpecialArgs = {inherit inputs;};}).options"
        },
        "nix-darwin": {
          "expr": "with (import ./.); (inputs.nix-darwin.lib.darwinSystem { pkgs = inputs.nixpkgs.legacyPackages.${builtins.currentSystem}; modules = [./nix/modules/host/essentials {}]; specialArgs = {inherit inputs;};}).options"
        }
      }
    }
  },
  "json.schemaDownload.trustedDomains": {
    "*": true
  },
  "pkl.lsp.java.path": "/home/biggs/code/system-configurations/.data/gc-roots/dev/shell-gc-root/bin/java",
  "rumdl.fixOnSave": true
}
