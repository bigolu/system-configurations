amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

exclude =
  List(
    ".vscode/ltex*",
    "program-configs/keyboard/US keyboard - no accent keys.bundle",
    "nix/pins/npins",
  )

hooks = new Mapping<String, Hook> {
  ["sync"] {
    steps = new Mapping<String, Step | Group> {
      ["direnv"] = new Step {
        glob =
          List(
            "hk.pkl",
            ".envrc-recommended.bash",
            // Everything below affects the nix dev shell, which direnv loads
            "**/*.nix",
            "flake.lock",
            "{nix,mise/tasks}/**/*",
          )
        // TODO: Real-Time output only shows if the command is on a single line.
        // This seems like a bug.
        check = nu("direnv reload; direnv exec . true")
      }
      // Why we use a group:
      //   - Ensure that the "direnv" step finishes before other steps start so the
      //     devshell logs/diff get printed in that step.
      //   - To set a `prefix` for the steps in the group.
      ["sync-2"] = new Group {
        prefix = List("mise", "run", "hk:run-in-dev-shell")
        steps {
          ["system"] = new Step {
            // I want to take input from the user for these reasons:
            //   - So I can input my password for `sudo`, used in the
            //     `hk:system-sync` mise task.
            //   - If the `--ask` flag is passed to the `sync` mise task, then
            //     `hk:system-sync` will prompt the user for confirmation.
            interactive = true
            glob =
              List(
                "hk.pkl",
                "{nix,program-configs}/**/*",
                "**/*.nix",
                "flake.lock",
              )
            check = nu("mise run hk:system-sync")
          }
          ["git-auto-sync"] = new Step {
            glob =
              List(
                "hk.pkl",
                // These could affect the version of the program being run.
                "**/*.nix",
                "flake.lock",
              )
            check = nu("git-auto-sync install mise run sync")
          }
          ["git-auto-check"] = new Step {
            glob =
              List(
                "hk.pkl",
                // These could affect the version of the program being run.
                "**/*.nix",
                "flake.lock",
              )
            // These steps can't run in parallel because they both fail if they
            // can't acquire a lock for `.git/config`.
            depends = List("git-auto-sync")
            check = nu("git-auto-check install mise run check")
          }
        }
      }
    }
  }
  ["check"] {
    // Ensure our pre-push hook fails, and the push gets aborted, if any
    // files get fixed.
    fail_on_fix = true

    steps =
      let (
        nonFormatterFixes = new Mapping<String, Step> {
          ["flake-lock"] = new Step {
            fix = nu("nix flake lock")
          }
          ["readme-config-names"] = new Step {
            // Ensure a lock is acquired for this file
            glob = "README.md"
            fix = nu("mise run hk:add-config-names-to-readme")
          }
          ["hk-import"] = new Step {
            // Ensure a lock is acquired for this file
            glob = "hk.pkl"
            fix = nu("mise run hk:update-hk-import")
          }
          ["deadnix"] = new Step {
            glob = "**/*.nix"
            fix = nu("deadnix --quiet --edit ...$files")
          }
          ["statix-fix"] = new Step {
            glob = "**/*.nix"
            fix = nu("$files | par-each { statix fix $in }")
          }
          ["npins"] = new Step {
            fix = nu("npins upgrade")
          }
          ["quotes"] = new Step {
            glob = "**/*"
            fix = nu("hk util fix-smart-quotes ...$files")
          }
          ["end-of-file"] = new Step {
            glob = "**/*"
            fix = nu("hk util end-of-file-fixer --fix ...$files")
          }
          ["mixed-line-ending"] = new Step {
            glob = "**/*"
            fix = nu("hk util mixed-line-ending --fix ...$files")
          }
        }
      )
      let (
        formatterFixes = new Mapping<String, Step> {
          ["tombi-format"] = new Step {
            glob = "**/*.toml"
            fix = nu("tombi format --quiet ...$files")
          }
          // This also acts a syntax checker for these file types since prettier will
          // fail if the files aren't syntactically correct.
          ["prettier"] = new Step {
            glob = "**/*.{json,jsonc,yaml}"
            fix =
              nu(
                #" prettier --cache --cache-location $"($env.PRJ_DATA_DIR)/prettier-cache" --cache-strategy metadata --list-different --write ...$files "#,
              )
          }
          ["nixfmt"] = new Step {
            glob = "**/*.nix"
            fix = nu("nixfmt --strict --verify ...$files")
          }
          ["stylua"] = new Step {
            glob = "**/*.lua"
            fix = nu("stylua --verify ...$files")
          }
          ["pkl-format"] = new Step {
            glob = "hk.pkl"
            fix = nu("pkl format --write ...$files")
          }
          ["rumdl-format-and-fix"] = new Step {
            glob = "**/*.md"
            fix = nu("rumdl fmt --silent ...$files")
          }
          ["nufmt"] = new Step {
            glob = "**/*.nu"
            fix = nu("nufmt ...$files")
          }
        }
      )
      // For `fail_fast` to be effective, steps should be ordered from fastest to
      // slowest. Run this command in nushell to print the steps sorted by duration:
      // with-env { HK_TIMING_JSON: '/dev/stdout' } { hk run check --all } | from json | get steps | transpose step duration | upsert duration {|row| $row.duration.wall_time_ms | into duration --unit ms } | sort-by duration
      let (
        checks = new Mapping<String, Step> {
          ["keyd"] = new Step {
            glob = "**/keyd/default.conf"
            check = nu("if (which keyd | is-not-empty) { keyd check ...$files }")
          }
          ["actionlint"] = new Step {
            glob = ".github/workflows/*.yaml"
            check = nu("actionlint ...$files")
          }
          ["rumdl-check"] = new Step {
            glob = "**/*.md"
            check = nu("rumdl check ...$files")
          }
          ["editorconfig-checker"] = new Step {
            glob = "**/*"
            check = nu("editorconfig-checker ...$files")
          }
          ["tombi-lint"] = new Step {
            glob = "**/*.toml"
            check = nu("tombi lint --quiet ...$files")
          }
          ["large-files"] = new Step {
            glob = "**/*"
            check = nu("hk util check-added-large-files ...$files")
          }
          ["case-conflict"] = new Step {
            glob = "**/*"
            check = nu("hk util check-case-conflict ...$files")
          }
          ["nixpkgs-lint"] = new Step {
            glob = "**/*.nix"
            check = nu("nixpkgs-lint --include-unfinished-lints -- ...$files")
          }
          ["statix-check"] = new Step {
            glob = "**/*.nix"
            check = nu("$files | par-each { statix check $in }")
          }
          ["pkl-lint"] = new Step {
            glob = "hk.pkl"
            check = nu("pkl eval ...$files | ignore --stdout")
          }
          ["renovate-config-validator"] = new Step {
            glob = "renovate.json"
            check = nu("renovate-config-validator --no-global --strict ...$files")
          }
          ["betterleaks"] = new Step {
            glob = "**/*"
            check =
              nu(
                "betterleaks dir --config betterleaks.toml --no-banner --verbose --log-level warn ...$files",
              )
          }
          ["lua-ls"] = new Step {
            // TODO: Real-Time output only shows if the command is on a single line.
            // This seems like a bug.
            check =
              nu(
                #" lua-language-server --logpath $"($env.PRJ_DATA_DIR)/lua-ls-logs" --check program-configs/neovim --configpath $"($env.PWD)/.luarc.json" "#,
              )
          }
          ["nix"] = new Step {
            // TODO: Real-Time output only shows if the command is on a single line.
            // This seems like a bug.
            check =
              nu(
                #" let dest = $"($env.PRJ_DATA_DIR)/gc-roots/checks"; rm -rf $dest; nix build --out-link $"($dest)/root" --impure --expr 'builtins.removeAttrs (import ./.).outputsForCurrentSystem.checks ["pkgs-shell-bundle"]' "#,
              )
          }
        }
      )
        // Fixes must run before checks for these reasons:
        //   - A fix could produce code that would fail a check
        //   - A fix could fix an issue that would have been found by a check
        //
        // Non-Formatter fixes must run before formatters since they may produce
        // code that doesn't comply with the formatting.
        (nonFormatterFixes.toMap() + formatterFixes.toMap() + checks.toMap()).toMapping()
  }
}

local function nu(function_body: String): Command = new Command {
  // TODO: Real-Time output only shows if the command is on a single line so
  // none of these arguments can have multiple lines. This seems like a bug.
  argv = List("nu", "--commands", "def main [...files] { \(function_body) }", "{{files}}")
}
